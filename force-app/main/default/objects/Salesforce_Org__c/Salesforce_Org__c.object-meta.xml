                </value>
                <value>
                    <fullName>Sandbox</fullName>
                    <default>false</default>
                    <label>Sandbox</label>
                </value>
                <value>
                    <fullName>Developer</fullName>
                    <default>false</default>
                    <label>Developer</label>
                </value>
                <value>
                    <fullName>Scratch</fullName>
                    <default>false</default>
                    <label>Scratch</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Instance_URL__c</fullName>
        <label>Instance URL</label>
        <type>Url</type>
        <required>false</required>
    </fields>
    <fields>
        <fullName>Org_ID__c</fullName>
        <label>Org ID</label>
        <type>Text</type>
        <length>18</length>
        <required>false</required>
